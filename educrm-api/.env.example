# ── App ────────────────────────────────────────────────────────
APP_ENV=production           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# ── Database ───────────────────────────────────────────────────
# DB_PASSWORD is used by docker-compose to build DATABASE_URL automatically.
# Set a strong random password (e.g. openssl rand -hex 32).
DB_PASSWORD=CHANGE_THIS_STRONG_DB_PASSWORD

# DATABASE_URL is constructed by docker-compose from DB_PASSWORD above.
# Override here only if you are NOT using docker-compose.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_THIS_STRONG_DB_PASSWORD@db:5432/educrm

DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── JWT ────────────────────────────────────────────────────────
# Must be at least 64 characters. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── CORS ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://studyflow.uz,https://www.studyflow.uz

# ── Telegram ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# ── Sentry (optional) ─────────────────────────────────────────
SENTRY_DSN=

# ── Rate limit ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120